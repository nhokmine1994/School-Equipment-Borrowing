<?php
session_start();
$is_logged_in = !empty($_SESSION['user']) && !empty($_SESSION['user']['username']);
$userSession = $is_logged_in && is_array($_SESSION['user']) ? $_SESSION['user'] : [];
$username = $is_logged_in ? (string) ($userSession['username'] ?? '') : '';

function seb_resolve_display_name(array $userSession): string
{
  $candidates = [
    $userSession['display_name'] ?? null,
    $userSession['full_name'] ?? null,
    $userSession['fullName'] ?? null,
    $userSession['FullName'] ?? null,
    $userSession['ten_hien_thi'] ?? null,
    $userSession['HoTen'] ?? null,
    $userSession['fullname'] ?? null,
    $userSession['name'] ?? null,
    $userSession['username'] ?? null,
  ];

  foreach ($candidates as $candidate) {
    $candidate = trim((string) $candidate);
    if ($candidate !== '') {
      return htmlspecialchars($candidate, ENT_QUOTES, 'UTF-8');
    }
  }

  return '';
}

$displayName = $is_logged_in ? seb_resolve_display_name($userSession) : '';
$userRole = strtolower(trim((string) ($userSession['role'] ?? '')));
$canAccessAdmin = $userRole === 'admin';

function seb_normalize_status($value)
{
  $text = mb_strtolower(trim((string) $value), 'UTF-8');
  if ($text === '') {
    return '';
  }

  return $text;
}

function seb_is_maintenance_status($status)
{
  $status = seb_normalize_status($status);
  return strpos($status, 'bảo trì') !== false || strpos($status, 'bao tri') !== false || strpos($status, 'unavailable') !== false || strpos($status, 'ngừng') !== false || strpos($status, 'ngung') !== false || strpos($status, 'disabled') !== false;
}

function seb_is_active_borrow_status($status)
{
  $status = seb_normalize_status($status);
  return in_array($status, array('approved', 'borrowed', 'dang_muon', 'Đang mượn'), true);
}

function seb_index_device_image_url($imagePath)
{
  if (empty($imagePath)) {
    return 'https://via.placeholder.com/80?text=No+Image';
  }

  $imagePath = trim((string) $imagePath);
  if (preg_match('/^(https?:\/\/|\/|\.\.\/|\.\/)/i', $imagePath)) {
    return $imagePath;
  }

  return 'Images/devices/' . ltrim($imagePath, "/\\");
}

function seb_format_time_ago($dateObj)
{
  if (!$dateObj) {
    return '';
  }

  if (is_object($dateObj) && method_exists($dateObj, 'getTimestamp')) {
    $timestamp = $dateObj->getTimestamp();
  } else {
    $timestamp = strtotime((string) $dateObj);
  }

  if (!$timestamp) {
    return '';
  }

  $now = time();
  $diff = $now - $timestamp;

  if ($diff < 60) {
    return 'Vừa mới';
  } elseif ($diff < 3600) {
    $minutes = floor($diff / 60);
    return $minutes . ' phút trước';
  } elseif ($diff < 86400) {
    $hours = floor($diff / 3600);
    return $hours . ' giờ trước';
  } elseif ($diff < 604800) {
    $days = floor($diff / 86400);
    return $days . ' ngày trước';
  } else {
    $weeks = floor($diff / 604800);
    return $weeks . ' tuần trước';
  }
}

function seb_load_json_stats($jsonPath)
{
  $stats = array(
    'total_devices' => 0,
    'maintenance_devices' => 0,
    'borrowed_devices' => 0,
  );

  if (!is_file($jsonPath)) {
    return $stats;
  }

  $content = file_get_contents($jsonPath);
  $devices = json_decode($content, true);
  if (!is_array($devices)) {
    return $stats;
  }

  foreach ($devices as $device) {
    $quantity = (int) ($device['quantity'] ?? $device['SoLuong'] ?? 0);
    if ($quantity <= 0) {
      $quantity = 1;
    }

    $stats['total_devices'] += $quantity;

    if (seb_is_maintenance_status($device['status'] ?? $device['TinhTrang'] ?? '')) {
      $stats['maintenance_devices'] += $quantity;
    }
  }

  return $stats;
}

function seb_load_index_stats($conn)
{
  if (!function_exists('sqlsrv_query') || empty($conn)) {
    return seb_load_json_stats(__DIR__ . '/data/devices.json');
  }

  require_once __DIR__ . '/components/seb_db.php';

  return seb_load_index_dashboard_stats($conn);
}

$conn = null;
if (function_exists('sqlsrv_connect')) {
  require_once __DIR__ . '/connect.php';
}

$indexStats = seb_load_index_stats($conn);

$recentBorrows = [];
if (!empty($conn) && function_exists('sqlsrv_query')) {
  require_once __DIR__ . '/components/seb_db.php';
  $borrowRows = seb_fetch_recent_phieu_muon($conn, 9);

  foreach ($borrowRows as $row) {
    $imagePath = trim((string) ($row['image'] ?? ''));
    $recentBorrows[] = [
      'id' => $row['id'],
      'name' => $row['name'],
      'quantity' => $row['quantity'],
      'username' => $row['username'],
      'borrowStatus' => $row['borrowStatus'],
      'soPhieu' => $row['soPhieuMuon'],
      'timeAgo' => seb_format_time_ago($row['ngayMuon'] ?? null),
      'image' => $imagePath,
    ];
  }
}

$maintenanceNotifications = [];
if (!empty($conn) && function_exists('sqlsrv_query')) {
  $maintenanceSql = "SELECT TOP 10 MaBaoTri, TieuDe, NoiDung, NgayCapNhat FROM BaoTriThongBao WHERE TrangThai = 1 ORDER BY ThuTuHienThi ASC, NgayCapNhat DESC";
  
  $maintenanceStmt = sqlsrv_query($conn, $maintenanceSql);
  if ($maintenanceStmt !== false) {
    while ($row = sqlsrv_fetch_array($maintenanceStmt, SQLSRV_FETCH_ASSOC)) {
      $dateObj = $row['NgayCapNhat'] ?? null;
      $formattedDate = '';
      
      if ($dateObj) {
        if (is_object($dateObj) && method_exists($dateObj, 'format')) {
          $formattedDate = $dateObj->format('d/m/Y');
        } else {
          $timestamp = strtotime((string) $dateObj);
          $formattedDate = $timestamp ? date('d/m/Y', $timestamp) : '';
        }
      }
      
      $maintenanceNotifications[] = [
        'id' => (int) ($row['MaBaoTri'] ?? 0),
        'title' => (string) ($row['TieuDe'] ?? ''),
        'content' => (string) ($row['NoiDung'] ?? ''),
        'date' => $formattedDate,
      ];
    }
  }
}
